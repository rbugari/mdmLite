# Database connection credentials used only by PostgreSQL
# For managed PostgreSQL with CA-signed certificates, prefer sslmode=verify-full in the URL.
DATABASE_URL=postgresql://postgres:your-password@db.example.internal:5432/mdm_lite?sslmode=verify-full
DATABASE_SSL_MODE=require
# System admin credentials used to sign in to MDM Lite
APP_ADMIN_USERNAME=admin
# Internal admin email used to resolve the ADMIN record inside mdm_user
APP_ADMIN_EMAIL=admin@mdmlite.local
APP_ADMIN_PASSWORD=change-me
NEXT_PUBLIC_APP_NAME=MDM Lite
APP_PORT=3003
MCP_PORT=3103
WORKER_PORT=3203
MCP_ENABLED=0
WORKER_ENABLED=0
APP_AUTH_SECRET=change-this-secret-now
